<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme: dark background so the splash / cold-start frame matches
         the Compose dark background (#121619) – prevents any white flash.
         NoActionBar is required as we rely entirely on Compose for the UI. -->
    <style name="Theme.TourShield" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>